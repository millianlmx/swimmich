    "%lld items moved to the system Recently Deleted album. Emptying it is what actually reclaims the space, and they stay available in Immich." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld éléments déplacés vers l'album « Récents supprimés » du système. C'est en le vidant que l'espace est réellement libéré, et ils restent disponibles dans Immich."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Elemente in das systemeigene Album „Zuletzt gelöscht“ verschoben. Erst dessen Leerung gibt den Speicher wirklich frei, und sie bleiben in Immich verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld elementos movidos al álbum «Eliminados recientemente» del sistema. Vaciarlo es lo que libera el espacio de verdad, y siguen disponibles en Immich."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld elementi spostati nell'album «Eliminati di recente» di sistema. È svuotandolo che lo spazio viene davvero liberato, e restano disponibili in Immich."
          }
        }
      }
    },
