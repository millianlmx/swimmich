{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ of originals taken on or before %@. They go to the system Recently Deleted album and stay available in Immich: only the copy on this device is removed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ d'originaux pris le %@ ou avant. Ils vont dans l'album « Récents supprimés » du système et restent disponibles dans Immich : seule la copie sur cet appareil est supprimée."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ an Originalen von %@ oder früher. Sie landen im systemeigenen Album „Zuletzt gelöscht“ und bleiben in Immich verfügbar: Nur die Kopie auf diesem Gerät wird entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de originales tomados el %@ o antes. Van al álbum «Eliminados recientemente» del sistema y siguen disponibles en Immich: solo se elimina la copia de este dispositivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ di originali scattati il %@ o prima. Vanno nell'album «Eliminati di recente» di sistema e restano disponibili in Immich: viene rimossa solo la copia su questo dispositivo."
          }
        }
      }
    },
    "%@ – %@" : {
      "localizations" : {
