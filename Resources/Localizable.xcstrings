    "For users that don't utilize the manual upload feature, you can now choose to add local photos directly into an album as you upload them, no need to upload then add to an album later anymore." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous n'utilisez pas l'import manuel, vous pouvez désormais ajouter des photos locales directement dans un album au moment de l'import, sans avoir à les importer puis à les ajouter à un album."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du den manuellen Upload nicht nutzt, kannst du lokale Fotos jetzt beim Hochladen direkt einem Album hinzufügen – kein separates Hochladen und anschließendes Einsortieren mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no usas la subida manual, ahora puedes añadir fotos locales directamente a un álbum mientras las subes, sin tener que subirlas y añadirlas después."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se non usi il caricamento manuale, ora puoi aggiungere le foto locali direttamente a un album mentre le carichi, senza doverle prima caricare e poi aggiungere all'album."
          }
        }
      }
    },
    "Free Up Space" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
