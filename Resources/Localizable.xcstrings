    "AirPlay cannot send a still photo. Use Screen Mirroring from Control Center." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPlay ne peut pas envoyer une photo fixe. Utilisez la duplication d'écran depuis le Centre de contrôle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPlay kann kein Standbild senden. Verwende die Bildschirmspiegelung im Kontrollzentrum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPlay no puede enviar una foto fija. Usa la duplicación de pantalla desde el Centro de Control."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPlay non può inviare una foto statica. Usa la duplicazione schermo dal Centro di Controllo."
          }
        }
      }
    },
